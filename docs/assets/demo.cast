[23.806821, "o", "\u001b[1;51H\u001b[38;5;6;49m2\u001b[2;24H\u001b[39;49m                                                                                                \u001b[3;24H\u001b[1m\u001b[38;5;3;49m  === Overview ===\u001b[4;24H\u001b[22m\u001b[38;5;15;49m  Memory is the most misunderstood Linux subsystem. On a healthy Linux system, nearly all RAM\u001b[5;24Happ\u001b[5;28Hars \"u\u001b[5;35Hed\" because the kernel aggressivel\u001b[5;70H caches disk da\u001b[5;86Ha.\u001b[5;89HThe key insight: \"used\" does\u001b[6;24Hnot mean \"unavailable.\" M\u001b[6;50HmAvailable (not M\u001b[6;68HmFree) i\u001b[6;78Hthe true indicator\u001b[6;97Hof how much memory\u001b[39;49m  \u001b[7;24H\u001b[38;5;15;49mapplic\u001b[7;31Htions c\u001b[7;39Hn still allocate without \u001b[7;65Hrigge\u001b[7;71Hing\u001b[7;75Hswapping.\u001b[39;49m                               \u001b[8;24H                                                            \u001b[9;24H\u001b[1m\u001b[38;5;3;49m  === Story ===\u001b[10;24H\u001b[22m\u001b[38;5;15;49m  \"Where did all my RAM go?\" — The Memory Story\u001b[11;24H\u001b[39;49m                                               \u001b[12;24H\u001b[38;5;15;49m  \u001b[13;26HStart at \u001b[1m\u001b[38;5;6;49mmeminfo\u001b[22m\u001b[38;5;15;49m. \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m shows your total phy\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mcal RAM. \u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m is the truly idle portion —\u001b[14;24Hoften surpri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mngly small. Do\u001b[14;53Hnot panic.\u001b[39;49m                                                        \u001b[15;24H                                       \u001b[16;24H\u001b[38;5;15;49m  \u001b[17;26HLinux uses free RAM for \u001b[1m\u001b[38;5;3;49mCached\u001b[22m\u001b[38;5;15;49m (page cache for file data) and \u001b[1m\u001b[38;5;3;49mBuffers\u001b[22m\u001b[38;5;15;49m (metadata cache). These\u001b[18;24Hare a\u001b[18;30Htomatically\u001b[18;42Hreclaimed when\u001b[18;57Ha\u001b[18;59Hplications need m\u001b[18;77Hmory. This\u001b[18;88His normal and de\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mr\u001b[18;108Hbl\u001b[18;111H —\u001b[18;114Hidle\u001b[39;49m \u001b[19;24H\u001b[38;5;15;49mRAM\u001b[19;28His was\u001b[19;35Hed RAM.\u001b[39;49m                                                                            \u001b[20;24H                  \u001b[21;24H\u001b[38;5;15;49m  \u001b[22;26H\u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is the kernel's estimate of memory available for new allocations without\u001b[23;24Hswapping. It combines\u001b[23;46H\u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m + recl\u001b[23;61Himable caches + reclaimable Slab. If \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is above\u001b[24;24H10% of \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m, you are generally fine.\u001b[39;49m                                                       \u001b[25;24H                                        \u001b[26;24H\u001b[38;5;15;49m  \u001b[27;26HWhen \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m drops low, the kernel begins swapping. Check \u001b[1m\u001b[38;5;6;49mswaps\u001b[22m\u001b[38;5;15;49m: if \u001b[1m\u001b[38;5;3;49mSwapUsed\u001b[22m\u001b[38;5;15;49m is growing,\u001b[28;24Hreal memory \u001b[1m\u001b[38;5;6;49mpressure\u001b[22m\u001b[38;5;15;49m exi\u001b[28;49Hts. Confirm with\u001b[28;66H\u001b[1m\u001b[38;5;6;49mvmstat\u001b[22m\u001b[38;5;15;49m: ri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mng \u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49m (swap-in) and \u001b[1m\u001b[38;5;3;49mso\u001b[22m\u001b[38;5;15;49m (swap-out) values\u001b[39;49m \u001b[29;24H\u001b[38;5;15;49mm\u001b[29;27Hn\u001b[29;29Hthe s\u001b[29;35"]
