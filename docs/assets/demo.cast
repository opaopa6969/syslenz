[24.310583, "o", "\u001b[1;51H\u001b[38;5;6;49m3\u001b[2;24H\u001b[1m\u001b[38;5;3;49m  === Overview ===\u001b[3;24H\u001b[22m\u001b[38;5;15;49m  Memory is the most misunderstood Linux subsystem. On a healthy Linux system, nearly all RAM\u001b[4;24Happ\u001b[4;28Hars \"u\u001b[4;35Hed\" because the kernel aggressivel\u001b[4;70H caches disk da\u001b[4;86Ha.\u001b[4;89HThe key insight: \"used\" does\u001b[5;24Hnot mean \"unavailable.\" M\u001b[5;50HmAvailable (not M\u001b[5;68HmFree) i\u001b[5;78Hthe true indicator\u001b[5;97Hof how much memory\u001b[39;49m  \u001b[6;24H\u001b[38;5;15;49mapplic\u001b[6;31Htions c\u001b[6;39Hn still allocate without \u001b[6;65Hrigge\u001b[6;71Hing\u001b[6;75Hswapping.\u001b[39;49m                               \u001b[7;24H                                                            \u001b[8;24H\u001b[1m\u001b[38;5;3;49m  === Story ===\u001b[9;24H\u001b[22m\u001b[38;5;15;49m  \"Where did all my RAM go?\" — The Memory Story\u001b[10;24H\u001b[39;49m                                               \u001b[11;24H\u001b[38;5;15;49m  \u001b[12;26HStart at \u001b[1m\u001b[38;5;6;49mmeminfo\u001b[22m\u001b[38;5;15;49m. \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m shows your total phy\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mcal RAM. \u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m is the truly idle portion —\u001b[13;24Hoften surpri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mngly small. Do\u001b[13;53Hnot panic.\u001b[39;49m                                                        \u001b[14;24H                                       \u001b[15;24H\u001b[38;5;15;49m  \u001b[16;26HLinux uses free RAM for \u001b[1m\u001b[38;5;3;49mCached\u001b[22m\u001b[38;5;15;49m (page cache for file data) and \u001b[1m\u001b[38;5;3;49mBuffers\u001b[22m\u001b[38;5;15;49m (metadata cache). These\u001b[17;24Hare a\u001b[17;30Htomatically\u001b[17;42Hreclaimed when\u001b[17;57Ha\u001b[17;59Hplications need m\u001b[17;77Hmory. This\u001b[17;88His normal and de\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mr\u001b[17;108Hbl\u001b[17;111H —\u001b[17;114Hidle\u001b[39;49m \u001b[18;24H\u001b[38;5;15;49mRAM\u001b[18;28His was\u001b[18;35Hed RAM.\u001b[39;49m                                                                            \u001b[19;24H                  \u001b[20;24H\u001b[38;5;15;49m  \u001b[21;26H\u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is the kernel's estimate of memory available for new allocations without\u001b[22;24Hswapping. It combines\u001b[22;46H"]
[24.310746, "o", "\u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m + recl\u001b[22;61Himable caches + reclaimable Slab. If \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is above\u001b[23;24H10% of \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m, you are generally fine.\u001b[39;49m                                                       \u001b[24;24H                                        \u001b[25;24H\u001b[38;5;15;49m  \u001b[26;26HWhen \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m drops low, the kernel begins swapping. Check \u001b[1m\u001b[38;5;6;49mswaps\u001b[22m\u001b[38;5;15;49m: if \u001b[1m\u001b[38;5;3;49mSwapUsed\u001b[22m\u001b[38;5;15;49m is growing,\u001b[27;24Hreal memory \u001b[1m\u001b[38;5;6;49mpressure\u001b[22m\u001b[38;5;15;49m exi\u001b[27;49Hts. Confirm with\u001b[27;66H\u001b[1m\u001b[38;5;6;49mvmstat\u001b[22m\u001b[38;5;15;49m: ri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mng \u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49m (swap-in) and \u001b[1m\u001b[38;5;3;49mso\u001b[22m\u001b[38;5;15;49m (swap-out) values\u001b[39;49m \u001b[28;24H\u001b[38;5;15;49mm\u001b[28;27Hn\u001b[28;29Hthe s\u001b[28;35Hstem is actively moving pages between RAM a\u001b[28;79Hd\u001b[28;81Hdisk. Al\u001b[1m\u001b[38;5;3;49mso\u001b[22m\u001b[38;5;15;49m check\u001b[28;98H\u001b[1m\u001b[38;5;3;49mpgmajfault\u001b[22m\u001b[38;5;15;49m — major\u001b[39;49m  \u001b[29;24H\u001b[38;5;15;49mpage\u001b[29;29Hfaults indicate \u001b[29;46Hhe kernel is\u001b[29;59Hfetching pages from \u001b[29;80Hisk that were \u001b[29;95Hvicted from RAM.\u001b[39;49m     \u001b[30;24H                                                                                       \u001b[31;24H\u001b[38;5;15;49m  \u001b[34;90H\u001b[38;5;8;49m1\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
[24.814745, "o", "\u001b[1;51H\u001b[38;5;6;49m4\u001b[2;24H\u001b[38;5;15;49m  Memory is the most misunderstood Linux subsystem. On a healthy Linux system, nearly all RAM\u001b[3;24Happ\u001b[3;28Hars \"u\u001b[3;35Hed\" because the kernel aggressivel\u001b[3;70H caches disk da\u001b[3;86Ha.\u001b[3;89HThe key insight: \"used\" does\u001b[4;24Hnot mean \"unavailable.\" M\u001b[4;50HmAvailable (not M\u001b[4;68HmFree) i\u001b[4;78Hthe true indicator\u001b[4;97Hof how much memory\u001b[39;49m  \u001b[5;24H\u001b[38;5;15;49mapplic\u001b[5;31Htions c\u001b[5;39Hn still allocate without \u001b[5;65Hrigge\u001b[5;71Hing\u001b[5;75Hswapping.\u001b[39;49m                               \u001b[6;24H                                                            \u001b[7;24H\u001b[1m\u001b[38;5;3;49m  === Story ===\u001b[8;24H\u001b[22m\u001b[38;5;15;49m  \"Where did all my RAM go?\" — The Memory Story\u001b[9;24H\u001b[39;49m                                               \u001b[10;24H\u001b[38;5;15;49m  \u001b[11;26HStart at \u001b[1m\u001b[38;5;6;49mmeminfo\u001b[22m\u001b[38;5;15;49m. \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m shows your total phy\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mcal RAM. \u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m is the truly idle portion —\u001b[12;24Hoften surpri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mngly small. Do\u001b[12;53Hnot panic.\u001b[39;49m                                                        \u001b[13;24H                                       \u001b[14;24H\u001b[38;5;15;49m  \u001b[15;26HLinux uses free RAM for \u001b[1m\u001b[38;5;3;49mCached\u001b[22m\u001b[38;5;15;49m (page cache for file data) and \u001b[1m\u001b[38;5;3;49mBuffers\u001b[22m\u001b[38;5;15;49m (metadata cache). These\u001b[16;24Hare a\u001b[16;30Htomatically\u001b[16;42Hreclaimed when\u001b[16;57Ha\u001b[16;59Hplications need m\u001b[16;77Hmory. This\u001b[16;88His normal and de\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mr\u001b[16;108Hbl\u001b[16;111H —\u001b[16;114Hidle\u001b[39;49m \u001b[17;24H\u001b[38;5;15;49mRAM\u001b[17;28His was\u001b[17;35Hed RAM.\u001b[39;49m                                                                            \u001b[18;24H                  \u001b[19;24H\u001b[38;5;15;49m  \u001b[20;26H\u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is the kernel's estimate of memory available for new allocations without\u001b[21;24Hswapping. It combines\u001b[21;46H\u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m + recl\u001b[21;61Himable caches + reclaimable Slab. If \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is above\u001b[22;24H10% of \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m, you are generally fine.\u001b[39;49m                                                       \u001b[23;24H                                        \u001b[24;24H\u001b[38;5;15;49m  \u001b[25;26HWhen \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m drops low, the kernel begins swapping. Check \u001b[1m\u001b[38;5;6;49mswaps\u001b[22m\u001b[38;5;15;49m: if \u001b[1m\u001b[38;5;3;49mSwapUsed\u001b[22m\u001b[38;5;15;49m is growing,\u001b[26;24Hreal memory \u001b[1m\u001b[38;5;6;49mpressure\u001b[22m\u001b[38;5;15;49m exi\u001b[26;49Hts. Confirm with\u001b[26;66H\u001b[1m\u001b[38;5;6;49mvmstat\u001b[22m\u001b[38;5;15;49m: ri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mng \u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49m (swap-in) and \u001b[1m\u001b[38;5;3;49mso\u001b[22m\u001b[38;5;15;49m (swap-out) values\u001b[39;49m \u001b[27;24H\u001b[38;5;15;49mm\u001b[27;27Hn\u001b[27;29Hthe s\u001b[27;35Hstem is actively moving pages between RAM a\u001b[27;79Hd\u001b[27;81Hdisk. Al\u001b[1m\u001b[38;5;3;49mso\u001b[22m\u001b[38;5;15;49m check\u001b[27;98H\u001b[1m\u001b[38;5;3;49mpgmajfault\u001b[22m\u001b[38;5;15;49m — major\u001b[39;49m  \u001b[28;24H\u001b[38;5;15;49mpage\u001b[28;29Hfaults indicate \u001b[28;46Hhe kernel is\u001b[28;59Hfetching pages from \u001b[28;80Hisk that were \u001b[28;95Hvicted from RAM.\u001b[39;49m     \u001b[29;24H                                                                                       \u001b[30;24H\u001b[38;5;15;49m  \u001b[31;26HFinally, \u001b[1m\u001b[38;5;6;49mpressure\u001b[22m\u001b[38;5;15;49m (PSI) gives a direct answer: if \u001b[1m\u001b[38;5;3;49mmemory_some_avg10\u001b[22m\u001b[38;5;15;49m > 0, tasks are currently\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
[25.318333, "o", "\u001b[1;3H\u001b[38;5;6;49mカ\u001b[1;5Hテ\u001b[1;7Hゴ\u001b[1;9Hリ\u001b[1;11H ──\u001b[1;25Hカ\u001b[1;27Hテ\u001b[1;29Hゴ\u001b[1;31Hリ\u001b[1;33Hガ\u001b[1;35Hイ\u001b[1;37Hド\u001b[1;42Hメ\u001b[1;44Hモ\u001b[1;46Hリ\u001b[2;10H\u001b[1mメ\u001b[2;12Hモ\u001b[2;14Hリ\u001b[2;26H\u001b[22m\u001b[38;5;15;49mメ\u001b[2;28Hモ\u001b[2;30Hリ\u001b[2;32Hは\u001b[2;34HLinuxで\u001b[2;41H最\u001b[2;43Hも\u001b[2;45H誤\u001b[2;47H解\u001b[2;49Hさ\u001b[2;51Hれ\u001b[2;53Hる\u001b[2;55Hサ\u001b[2;57Hブ\u001b[2;59Hシ\u001b[2;61Hス\u001b[2;63Hテ\u001b[2;65Hム\u001b[2;67Hで\u001b[2;69Hす\u001b[2;71H。\u001b[2;73H健\u001b[2;75H全\u001b[2;77Hな\u001b[2;79HLinuxシ\u001b[2;86Hス\u001b[2;88Hテ\u001b[2;90Hム\u001b[2;92Hで\u001b[2;94Hは\u001b[2;96H、\u001b[2;98Hほ\u001b[2;100Hぼ\u001b[2;102H全\u001b[2;104Hて\u001b[2;106Hの\u001b[2;108HRAMが\u001b[2;113H「\u001b[2;115H使\u001b[2;117H用\u001b[3;16H負\u001b[3;18H荷\u001b[3;24H中\u001b[3;26H」\u001b[3;28Hに\u001b[3;30H見\u001b[3;32Hえ\u001b[3;34Hま\u001b[3;36Hす\u001b[3;38H。\u001b[3;40Hカ\u001b[3;42Hー\u001b[3;44Hネ\u001b[3;46Hル\u001b[3;48Hが\u001b[3;50Hデ\u001b[3;52Hィ\u001b[3;54Hス\u001b[3;56Hク\u001b[3;58Hデ\u001b[3;60Hー\u001b[3;62Hタ\u001b[3;64Hを\u001b[3;66H積\u001b[3;68H極\u001b[3;70H的\u001b[3;72Hに\u001b[3;74Hキ\u001b[3;76Hャ\u001b[3;78Hッ\u001b[3;80Hシ\u001b[3;82Hュ\u001b[3;84Hす\u001b[3;86Hる\u001b[3;88Hた\u001b[3;90Hめ\u001b[3;92Hで\u001b[3;94Hす\u001b[3;96H。\u001b[3;98H重\u001b[3;100H要\u001b[3;102Hな\u001b[3;104H点\u001b[3;106H：\u001b[3;108H「\u001b[3;110H使\u001b[3;112H用\u001b[3;114H中\u001b[3;116H」\u001b[3;118Hは\u001b[4;10Hネ\u001b[4;12Hッ\u001b[4;14Hト\u001b[4;16Hワ\u001b[4;18Hー\u001b[4;20Hク\u001b[4;24H「\u001b[4;26H利\u001b[4;28H用\u001b[4;30H不\u001b[4;32H可\u001b[4;34H」\u001b[4;36Hで\u001b[4;38Hは\u001b[4;40Hあ\u001b[4;42Hり\u001b[4;44Hま\u001b[4;46Hせ\u001b[4;48Hん\u001b[4;50H。\u001b[4;52HMemAvailable（\u001b[4;73Hで\u001b[4;75Hは\u001b[4;77Hな\u001b[4;79Hい\u001b[4;81H）\u001b[4;83Hが\u001b[4;85H、\u001b[4;87Hス\u001b[4;89Hワ\u001b[4;91Hッ\u001b[4;93Hプ\u001b[4;95Hを\u001b[4;97H発\u001b[4;99H生\u001b[4;101Hさ\u001b[4;103Hせ