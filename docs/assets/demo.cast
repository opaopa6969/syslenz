[21.802755, "o", "\u001b[1;1H\u001b[38;5;6;49m┌ Categories ────────┐┌ Category Guide — Memory  [1/49] ───────────────────────────────────────────────────────────────┐\u001b[2;1H│> \u001b[38;5;3;49m[MEM] \u001b[1m\u001b[38;5;6;49mMemory\u001b[22m\u001b[39;49m      \u001b[38;5;6;49m││\u001b[38;5;8;49m  Related sources: \u001b[38;5;6;49mmeminfo\u001b[38;5;8;49m, \u001b[38;5;6;49mvmstat\u001b[38;5;8;49m, \u001b[38;5;6;49mswaps\u001b[38;5;8;49m, \u001b[38;5;6;49mbuddyinfo\u001b[38;5;8;49m, \u001b[38;5;6;49mpressure\u001b[38;5;8;49m, \u001b[38;5;6;49mzoneinfo\u001b[38;5;8;49m, \u001b[38;5;6;49mslabinfo\u001b[38;5;8;49m, \u001b[38;5;6;49mpagetypeinfo│\u001b[3;1H│  \u001b[38;5;3;49m[CPU] \u001b[38;5;15;49mCPU / Load\u001b[39;49m  \u001b[38;5;6;49m││\u001b[39;49m                                                                                                \u001b[38;5;6;49m│\u001b[4;1H│  \u001b[38;5;3;49m[NET] \u001b[38;5;15;49mNetwork\u001b[39;49m     \u001b[38;5;6;49m││\u001b[1m\u001b[38;5;3;49m  === Overview ===\u001b[22m\u001b[39;49m                                                                              \u001b[38;5;6;49m│\u001b[5;1H│  \u001b[38;5;3;49m[DSK] \u001b[38;5;15;49mStorage\u001b[39;49m     \u001b[38;5;6;49m││\u001b[38;5;15;49m  Memory is the most misunderstood Linux subsystem. On a healthy Linux system, nearly all RAM\u001b[39;49m   \u001b[38;5;6;49m│\u001b[6;1H│  \u001b[38;5;3;49m[PRC] \u001b[38;5;15;49mProcess\u001b[39;49m     \u001b[38;5;6;49m││\u001b[38;5;15;49mappears \"used\" because the kernel aggressively caches disk data. The key insight: \"used\" does\u001b[39;49m   \u001b[38;5;6;49m│\u001b[7;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mnot mean \"unavailable.\" MemAvailable (not MemFree) is the true indicator of how much memory\u001b[39;49m     \u001b[38;5;6;49m│\u001b[8;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mapplications can still allocate without triggering swapping.\u001b[39;49m                                    \u001b[38;5;6;49m│\u001b[9;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[39;49m                                                                                                \u001b[38;5;6;49m│\u001b[10;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[1m\u001b[38;5;3;49m  === Story ===\u001b[22m\u001b[39;49m                                                                                 \u001b[38;5;6;49m│\u001b[11;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  \"Where did all my RAM go?\" — The Memory Story\u001b[39;49m                                                 \u001b[38;5;6;49m│\u001b[12;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[39;49m                                                                                                \u001b[38;5;6;49m│\u001b[13;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  \u001b[39;49m                                                                                              \u001b[38;5;6;49m│\u001b[14;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  Start at \u001b[1m\u001b[38;5;6;49mmeminfo\u001b[22m\u001b[38;5;15;49m. \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m shows your total phy\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mcal RAM. \u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m is the truly idle portion —\u001b[39;49m \u001b[38;5;6;49m│\u001b[15;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49moften surpri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mngly small. Do not panic.\u001b[39;49m                                                         \u001b[38;5;6;49m│\u001b[16;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[39;49m                                                                                                \u001b[38;5;6;49m│\u001b[17;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  \u001b[39;49m                                                                                              \u001b[38;5;6;49m│\u001b[18;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  Linux uses free RAM for \u001b[1m\u001b[38;5;3;49mCached\u001b[22m\u001b[38;5;15;49m (page cache for file data) and \u001b[1m\u001b[38;5;3;49mBuffers\u001b[22m\u001b[38;5;15;49m (metadata cache). These\u001b[39;49m \u001b[38;5;6;49m│\u001b[19;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mare automatically reclaimed when applications nee"]
[21.802949, "o", "d memory. This is normal and de\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mrable — idle\u001b[39;49m  \u001b[38;5;6;49m│\u001b[20;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mRAM is wasted RAM.\u001b[39;49m                                                                              \u001b[38;5;6;49m│\u001b[21;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[39;49m                                                                                                \u001b[38;5;6;49m│\u001b[22;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  \u001b[39;49m                                                                                              \u001b[38;5;6;49m│\u001b[23;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is the kernel's estimate of memory available for new allocations without\u001b[39;49m         \u001b[38;5;6;49m│\u001b[24;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mswapping. It combines \u001b[1m\u001b[38;5;3;49mMemFree\u001b[22m\u001b[38;5;15;49m + reclaimable caches + reclaimable Slab. If \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m is above\u001b[39;49m \u001b[38;5;6;49m│\u001b[25;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m10% of \u001b[1m\u001b[38;5;3;49mMemTotal\u001b[22m\u001b[38;5;15;49m, you are generally fine.\u001b[39;49m                                                        \u001b[38;5;6;49m│\u001b[26;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[39;49m                                                                                                \u001b[38;5;6;49m│\u001b[27;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  \u001b[39;49m                                                                                              \u001b[38;5;6;49m│\u001b[28;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49m  When \u001b[1m\u001b[38;5;3;49mMemAvailable\u001b[22m\u001b[38;5;15;49m drops low, the kernel begins swapping. Check \u001b[1m\u001b[38;5;6;49mswaps\u001b[22m\u001b[38;5;15;49m: if \u001b[1m\u001b[38;5;3;49mSwapUsed\u001b[22m\u001b[38;5;15;49m is growing,\u001b[39;49m \u001b[38;5;6;49m│\u001b[29;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mreal memory \u001b[1m\u001b[38;5;6;49mpressure\u001b[22m\u001b[38;5;15;49m exists. Confirm with \u001b[1m\u001b[38;5;6;49mvmstat\u001b[22m\u001b[38;5;15;49m: ri\u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49mng \u001b[1m\u001b[38;5;3;49msi\u001b[22m\u001b[38;5;15;49m (swap-in) and \u001b[1m\u001b[38;5;3;49mso\u001b[22m\u001b[38;5;15;49m (swap-out) values\u001b[39;49m  \u001b[38;5;6;49m│\u001b[30;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mmean the system is actively moving pages between RAM and disk. Al\u001b[1m\u001b[38;5;3;49mso\u001b[22m\u001b[38;5;15;49m check \u001b[1m\u001b[38;5;3;49mpgmajfault\u001b[22m\u001b[38;5;15;49m — major\u001b[39;49m    \u001b[38;5;6;49m│\u001b[31;1H│\u001b[39;49m                    \u001b[38;5;6;49m││\u001b[38;5;15;49mpage faults indicate the kernel is fetching pages from disk that were evicted from RAM.\u001b[39;49m         \u001b[38;5;6;49m│\u001b[32;1H└────────────────────┘└────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[34;110H\u001b[1mCATEG\u001b[34;116HRY G\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
