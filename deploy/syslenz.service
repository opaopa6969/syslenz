[Unit]
Description=syslenz — Web UI + MCP server
After=network.target

[Service]
Type=simple
Environment=PORT=3009
EnvironmentFile=-/home/opa/volta-secrets/syslenz.env
ExecStart=/home/opa/syslenz/run.sh
WorkingDirectory=/home/opa/syslenz
Restart=always
RestartSec=5
# Keep a runaway collector from exhausting the host; systemd restarts it.
MemoryMax=1G

[Install]
WantedBy=default.target
